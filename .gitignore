__pycache__/
*.pyc
output/
.tmt_key
# Per-provider API keys, and the temporary file they are written through.
# Obfuscated, not encrypted: staying out of commits is half of what protects
# them, the file permissions being the other half.
.tmt_providers.json
.tmt_providers.json.tmp
.tmt_git.local
activatevenv.exe
logs/

# Build artefacts from an editable install. Regenerated by pip, never source.
*.egg-info/
build/
dist/

# Working references and per-install choices, not source.
DESIGN_PRINCIPLES.md
.tmt_model
.tmt_effort

# The code index and the project notebook. Both live beside the install, and
# when TMT is run ON TMT the install and the workspace are the same directory,
# so both land here and would otherwise be committed. Caches keyed by absolute
# path are worthless to anyone else and the notebook is per-machine.
.tmt_index/
.tmt_memory/

# Working notes for the assistant. Per-checkout, not source.
CLAUDE.local.md

# Recon notes for the multi-agent work: machine-generated subsystem maps, kept
# beside CLAUDE.local.md as working material rather than source.
MULTIAGENT_RECON.md

# The brief for the next session on the multi-agent work. Working material.
multiagent_promt_*.md
