# TMT's own git identity. Committed on purpose: a commit email is public
# metadata, not a credential, so every clone gets the same TMT identity.
# Never put tokens, passwords or keys in this file.
#
# This address belongs to the GitHub account that represents TMT:
# https://github.com/TMT-git
# GitHub attributes a commit to that account by matching this address
# against the addresses verified on it.
TMT_GIT_NAME=TMT code
TMT_GIT_EMAIL=tmt.tmt@gmail.com
