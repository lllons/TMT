# TMT's own git identity. Committed on purpose: a commit email is public
# metadata, not a credential, so every clone gets the same TMT identity.
# Never put tokens, passwords or keys in this file.
#
# Replace the address below with one verified on the GitHub account that
# represents TMT. Until then TMT refuses to commit rather than authoring
# commits under an address GitHub cannot attribute to anyone.
TMT_GIT_NAME=TMT code
TMT_GIT_EMAIL=REPLACE_WITH_TMT_GITHUB_ACCOUNT_EMAIL
